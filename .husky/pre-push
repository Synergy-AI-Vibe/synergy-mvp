echo "[pre-push] 타입 체크 중..."
npx tsc --noEmit || exit 1

echo "[pre-push] next build 확인 중..."
npm run build || exit 1

if [ -f ".vercel/project.json" ]; then
  echo "[pre-push] vercel 프로젝트 설정 동기화 중..."
  npx vercel pull --yes || exit 1
  echo "[pre-push] vercel build 확인 중..."
  npx vercel build || exit 1
else
  echo "[pre-push] Vercel 프로젝트가 아직 연결되지 않아 vercel build는 건너뜁니다. ('vercel link'로 연결하면 자동으로 포함됩니다)"
fi
